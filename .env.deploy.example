# Copy this file to .env.deploy and fill it in. .env.deploy is ignored by git.
# Never put a password or a private key in here: use an SSH key file
# (DEPLOY_SSH_KEY is only the path to it), or type the password when asked.

# Your VPS IP address or hostname
DEPLOY_HOST=203.0.113.10
# The Linux user you log in with
DEPLOY_USER=deploy
# Folder on the server. nginx serves DEPLOY_PATH/current
DEPLOY_PATH=/var/www/nebras-portfolio
# SSH port (22 unless you changed it)
DEPLOY_PORT=22
# Optional: path to your private key on this PC, e.g. C:\Users\you\.ssh\id_ed25519
DEPLOY_SSH_KEY=
