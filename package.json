{
  "name": "nebras-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio: a static Next.js site with a Git-based admin panel, scroll-driven motion and a WebGL background.",
  "homepage": "https://nebras.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NebrasAbderrazak/myporfolio-template.git"
  },
  "license": "MIT",
  "author": "Nebras Abderrazak",
  "scripts": {
    "predev": "node scripts/optimize-images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "node scripts/serve-out.mjs",
    "images": "node scripts/optimize-images.mjs",
    "new:project": "node scripts/new-project.mjs",
    "new:update": "node scripts/new-update.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "motion": "^14.2.0",
    "next": "16.4.1",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
